# ===== NavyAI (https://api.navy — API tương thích OpenAI) — CHỈ đặt ở server, không có tiền tố NEXT_PUBLIC =====
NAVY_API_KEY=sk-navy-KKPJVJf9jyb05fO2Add5jALLwFCKP5LxDdNWtsvRP-Q
NAVY_BASE_URL=https://api.navy/v1
# Model cho tạo đề / chấm bài và model nhanh cho giải thích (xem GET /v1/models để biết model tài khoản bạn dùng được)
NAVY_MODEL=pt-6-luna
NAVY_MODEL_FAST=gemini-2.5-flash


# Bắt buộc đăng nhập mới dùng AI (khuyên bật khi deploy công khai)
AI_REQUIRE_AUTH=true
# Số lượt gọi AI tối đa mỗi người trong 10 phút
AI_RATE_LIMIT=20

# ===== App di động (Capacitor) =====
# Bản build tĩnh trong app không có API route, nên trỏ về server đã deploy:
# NEXT_PUBLIC_API_BASE=https://on-thi.your-domain.com
# Origin được phép gọi API từ app (CORS)
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost
